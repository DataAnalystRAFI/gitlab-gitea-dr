GITEA__server__DOMAIN=gitlab-dr.local
GITEA__server__SSH_DOMAIN=gitlab-dr.local
GITEA__server__ROOT_URL=http://gitlab-dr.local:3000
GITEA__server__HTTP_PORT=3000
GITEA__server__SSH_PORT=22
GITEA__server__DISABLE_SSH=false
GITEA__server__START_SSH_SERVER=true
GITEA__server__OFFLINE_MODE=false
GITEA__security__INSTALL_LOCK=true
GITEA__security__SECRET_KEY=${GITEA_SECRET_KEY:-changeme}
GITEA__service__DISABLE_REGISTRATION=true
GITEA__service__REQUIRE_SIGNIN_VIEW=true
GITEA__mirror__DEFAULT_INTERVAL=8h
GITEA__mirror__MIN_INTERVAL=10m
